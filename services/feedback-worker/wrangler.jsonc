{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tmcc-tools-feedback",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": {
    "enabled": true
  },
  "env": {
    "preview": {
      "name": "tmcc-tools-feedback-preview",
      "vars": {
        "ALLOWED_ORIGINS": "http://127.0.0.1:5174,http://localhost:5174",
        "FEEDBACK_FROM": "TMCC Feedback <feedback@notify.tmccdb.org>"
      },
      "ratelimits": [
        {
          "name": "FEEDBACK_RATE_LIMITER",
          "namespace_id": "1101",
          "simple": { "limit": 5, "period": 60 }
        }
      ]
    },
    "production": {
      "name": "tmcc-tools-feedback",
      "vars": {
        "ALLOWED_ORIGINS": "https://tmccdb.org,https://www.tmccdb.org",
        "FEEDBACK_FROM": "TMCC Feedback <feedback@notify.tmccdb.org>"
      },
      "ratelimits": [
        {
          "name": "FEEDBACK_RATE_LIMITER",
          "namespace_id": "1102",
          "simple": { "limit": 5, "period": 60 }
        }
      ]
    }
  }
}
